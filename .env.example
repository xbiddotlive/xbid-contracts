# Robinhood Chain Testnet only. Never commit real private keys or provider secrets.
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
ROBINHOOD_TESTNET_CHAIN_ID=46630
ROBINHOOD_TESTNET_BLOCKSCOUT_API_URL=https://explorer.testnet.chain.robinhood.com/api/

DEPLOYER_PRIVATE_KEY=0x_REPLACE_WITH_TESTNET_DEPLOYER_KEY
XBID_GOVERNANCE_SAFE=0xf72028a7f304e0585bdF7cd8BB0E0cB91fF2fBe1
XBID_EMERGENCY_ROLE=0x7f4601752bd49155c47A943893Ddb13C9f1Aa446
XBID_GOVERNANCE_TIMELOCK=0x_REPLACE_AFTER_5_MIN_TESTNET_TIMELOCK_DEPLOYMENT
XBID_TEAM_TREASURY=0x6ae1c7b6c583e50777002b70fe289321f23b8ff3
XBID_PROTOCOL_TREASURY=0x786c860a8659b63ebdf885a93a78282b2c80214b

# The deploy wrapper sets SOURCE_COMMIT automatically. Direct forge script use must set it.
SOURCE_COMMIT=REPLACE_WITH_FULL_GIT_COMMIT
TIMELOCK_OUTPUT_PATH=deployments/robinhood-testnet/timelock.json
TIMELOCK_MANIFEST_PATH=deployments/robinhood-testnet/timelock.json
DEPLOYMENT_OUTPUT_PATH=deployments/robinhood-testnet/latest.json
DEPLOYMENT_MANIFEST_PATH=deployments/robinhood-testnet/latest.json
REQUIRE_ACTIVATED=true
CONFIRM_ROBINHOOD_TIMELOCK_DEPLOYMENT=NO
CONFIRM_ROBINHOOD_TESTNET_DEPLOYMENT=NO
