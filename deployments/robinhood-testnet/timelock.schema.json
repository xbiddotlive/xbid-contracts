{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xbid.live/schemas/robinhood-testnet-timelock-v1.json",
  "title": "XBID Robinhood Testnet Timelock manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "environment",
    "status",
    "chainId",
    "simulationBlock",
    "deploymentBlock",
    "deploymentTransactionHash",
    "sourceCommit",
    "deployer",
    "governanceSafe",
    "emergencySafe",
    "timelock",
    "timelockCodeHash",
    "minimumDelaySeconds",
    "proposer",
    "executor",
    "canceller",
    "admin"
  ],
  "properties": {
    "manifestVersion": { "const": 1 },
    "environment": { "const": "robinhood-testnet" },
    "status": { "const": "ACTIVE" },
    "chainId": { "const": 46630 },
    "simulationBlock": { "type": "integer", "minimum": 1 },
    "deploymentBlock": { "type": "integer", "minimum": 1 },
    "deploymentTransactionHash": { "$ref": "#/$defs/bytes32" },
    "sourceCommit": { "type": "string", "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$" },
    "deployer": { "$ref": "#/$defs/address" },
    "governanceSafe": { "const": "0xf72028a7f304e0585bdF7cd8BB0E0cB91fF2fBe1" },
    "emergencySafe": { "const": "0x7f4601752bd49155c47A943893Ddb13C9f1Aa446" },
    "timelock": { "$ref": "#/$defs/address" },
    "timelockCodeHash": { "$ref": "#/$defs/bytes32" },
    "minimumDelaySeconds": { "const": 300 },
    "proposer": { "const": "0xf72028a7f304e0585bdF7cd8BB0E0cB91fF2fBe1" },
    "executor": { "const": "0xf72028a7f304e0585bdF7cd8BB0E0cB91fF2fBe1" },
    "canceller": { "const": "0xf72028a7f304e0585bdF7cd8BB0E0cB91fF2fBe1" },
    "admin": { "$ref": "#/$defs/address" }
  },
  "$defs": {
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "bytes32": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" }
  }
}
