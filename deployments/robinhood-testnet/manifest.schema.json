{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xbid.live/schemas/robinhood-testnet-deployment-v1.json",
  "title": "XBID Robinhood Testnet deployment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "environment",
    "status",
    "chainId",
    "indexerStartBlock",
    "sourceCommit",
    "deployer",
    "governanceTimelock",
    "emergencyRole",
    "teamTreasury",
    "protocolTreasury",
    "settlementToken",
    "settlementTokenRuntimeHash",
    "marketRegistry",
    "marketRegistryCodeHash",
    "riskController",
    "riskControllerCodeHash",
    "feeVault",
    "feeVaultCodeHash",
    "marketVaultImplementation",
    "marketVaultImplementationCodeHash",
    "sideTokenImplementation",
    "sideTokenImplementationCodeHash",
    "factoryImplementation",
    "factoryImplementationCodeHash",
    "factoryProxy",
    "factoryProxyCodeHash",
    "marketVersion",
    "feeVaultVersion",
    "riskControllerVersion",
    "abiVersion",
    "creationFeeUnits",
    "activationSetRegistrarTarget",
    "activationSetRegistrarCalldata",
    "activationSetDefaultVersionTarget",
    "activationSetDefaultVersionCalldata"
  ],
  "properties": {
    "manifestVersion": { "const": 1 },
    "environment": { "const": "robinhood-testnet" },
    "status": { "const": "PENDING_GOVERNANCE_ACTIVATION" },
    "chainId": { "const": 46630 },
    "indexerStartBlock": { "type": "integer", "minimum": 1 },
    "sourceCommit": { "type": "string", "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$" },
    "deployer": { "$ref": "#/$defs/address" },
    "governanceTimelock": { "$ref": "#/$defs/address" },
    "emergencyRole": { "$ref": "#/$defs/address" },
    "teamTreasury": { "$ref": "#/$defs/address" },
    "protocolTreasury": { "$ref": "#/$defs/address" },
    "settlementToken": { "const": "0xAc80194dc1aE8eF52df73e7e1864fB3C62290fe0" },
    "settlementTokenRuntimeHash": {
      "const": "0xf45e11ddae86e83321f1f290f0e6e99f50dceb81d19b7edbf2bf1b1fbb0c9b5c"
    },
    "marketRegistry": { "$ref": "#/$defs/address" },
    "marketRegistryCodeHash": { "$ref": "#/$defs/bytes32" },
    "riskController": { "$ref": "#/$defs/address" },
    "riskControllerCodeHash": { "$ref": "#/$defs/bytes32" },
    "feeVault": { "$ref": "#/$defs/address" },
    "feeVaultCodeHash": { "$ref": "#/$defs/bytes32" },
    "marketVaultImplementation": { "$ref": "#/$defs/address" },
    "marketVaultImplementationCodeHash": { "$ref": "#/$defs/bytes32" },
    "sideTokenImplementation": { "$ref": "#/$defs/address" },
    "sideTokenImplementationCodeHash": { "$ref": "#/$defs/bytes32" },
    "factoryImplementation": { "$ref": "#/$defs/address" },
    "factoryImplementationCodeHash": { "$ref": "#/$defs/bytes32" },
    "factoryProxy": { "$ref": "#/$defs/address" },
    "factoryProxyCodeHash": { "$ref": "#/$defs/bytes32" },
    "marketVersion": { "const": 1 },
    "feeVaultVersion": { "const": 1 },
    "riskControllerVersion": { "const": 1 },
    "abiVersion": { "const": 1 },
    "creationFeeUnits": { "const": 5000000 },
    "activationSetRegistrarTarget": { "$ref": "#/$defs/address" },
    "activationSetRegistrarCalldata": { "$ref": "#/$defs/calldata" },
    "activationSetDefaultVersionTarget": { "$ref": "#/$defs/address" },
    "activationSetDefaultVersionCalldata": { "$ref": "#/$defs/calldata" }
  },
  "$defs": {
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "bytes32": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "calldata": { "type": "string", "pattern": "^0x(?:[0-9a-fA-F]{2})+$" }
  }
}
